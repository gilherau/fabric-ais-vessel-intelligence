    AisNormalized
    | where ParseSucceeded
    | where Category == "Static"
    | project
        ReceivedTime,
        SentenceType,
        TotalFragments,
        FragmentNumber,
        SequenceId,
        Channel,
        Payload,
        FillBits,
        Checksum,
        MessageType,
        MessageName,
        Category,
        IsMultipart,
        PayloadLength,
        ParseSucceeded
}

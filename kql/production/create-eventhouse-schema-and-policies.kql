}
.create-or-alter function with (folder = "AIS/Routing", skipvalidation = "true") RouteAisDeadLetter() {
    let NmeaRegex =
        @"^!(AIVDM|AIVDO),(\d+),(\d+),([^,]*),([AB]?),([^,]+),(\d+)\*([0-9A-Fa-f]{2})$";
    AisRaw
    | extend
        Payload = extract(NmeaRegex, 6, RawSentence)
    | extend
        PayloadPrefix = substring(Payload, 0, 1)
    | extend
        MessageType = tolong(
            indexof(
                "123456789:;<=>?@ABCDEFGHIJK",
                PayloadPrefix
            ) + 1
        )
    | where isempty(Payload) or MessageType !between (1 .. 27)
    | extend ParseError = case(
        isempty(Payload),
            "NMEA envelope did not match the AIVDM/AIVDO regular expression",
        MessageType !between (1 .. 27),
            "AIS payload prefix does not identify message type 1 through 27",
        "Unknown parsing error"
    )
    | project
        ReceivedTime,
        RawSentence,
        ParseError
}
.create-or-alter function with (folder = "AIS/Decoding", docstring = "Decode single-fragment AIS Class A position reports, message types 1, 2, and 3", skipvalidation = "true") DecodeAisClassAPosition() {
    AisPositionReports
    | where isnotempty(Payload)
    | where strlen(Payload) == 28
    | serialize SourceRowId = row_number()
    | extend CharacterCodes = unicode_codepoints_from_string(Payload)
    | extend BitPositions = range(0, 167, 1)
    | mv-expand BitPosition = BitPositions to typeof(long)
    | extend CharacterIndex = toint(BitPosition / 6)
    | extend BitInCharacter = toint(BitPosition % 6)
    | extend CharacterCode = tolong(CharacterCodes[CharacterIndex])
    | extend SixBitValue = CharacterCode - 48 - iff(CharacterCode - 48 > 39, 8, 0)
    | extend BitValue = tolong(binary_and(binary_shift_right(SixBitValue, 5 - BitInCharacter), 1))
    | summarize
        DecodedMessageType = sum(iff(BitPosition between (0 .. 5), BitValue * binary_shift_left(1, toint(5 - BitPosition)), long(0))),
        RepeatIndicator = sum(iff(BitPosition between (6 .. 7), BitValue * binary_shift_left(1, toint(7 - BitPosition)), long(0))),
        MMSI = sum(iff(BitPosition between (8 .. 37), BitValue * binary_shift_left(1, toint(37 - BitPosition)), long(0))),
        NavigationStatus = sum(iff(BitPosition between (38 .. 41), BitValue * binary_shift_left(1, toint(41 - BitPosition)), long(0))),
        RateOfTurnUnsigned = sum(iff(BitPosition between (42 .. 49), BitValue * binary_shift_left(1, toint(49 - BitPosition)), long(0))),
        SpeedOverGroundRaw = sum(iff(BitPosition between (50 .. 59), BitValue * binary_shift_left(1, toint(59 - BitPosition)), long(0))),
        PositionAccuracyRaw = sum(iff(BitPosition == 60, BitValue, long(0))),
        LongitudeUnsigned = sum(iff(BitPosition between (61 .. 88), BitValue * binary_shift_left(1, toint(88 - BitPosition)), long(0))),
        LatitudeUnsigned = sum(iff(BitPosition between (89 .. 115), BitValue * binary_shift_left(1, toint(115 - BitPosition)), long(0))),
        CourseOverGroundRaw = sum(iff(BitPosition between (116 .. 127), BitValue * binary_shift_left(1, toint(127 - BitPosition)), long(0))),
        TrueHeadingRaw = sum(iff(BitPosition between (128 .. 136), BitValue * binary_shift_left(1, toint(136 - BitPosition)), long(0))),
        UTCSecondRaw = sum(iff(BitPosition between (137 .. 142), BitValue * binary_shift_left(1, toint(142 - BitPosition)), long(0))),
        ManeuverIndicator = sum(iff(BitPosition between (143 .. 144), BitValue * binary_shift_left(1, toint(144 - BitPosition)), long(0))),
        RAIMRaw = sum(iff(BitPosition == 148, BitValue, long(0)))
      by SourceRowId,
         ReceivedTime,
         SentenceType,
         TotalFragments,
         FragmentNumber,
         SequenceId,
         Channel,
         Payload,
         FillBits,
         Checksum
    | where DecodedMessageType in (1, 2, 3)
    | extend
        LongitudeSigned = iff(
            LongitudeUnsigned >= binary_shift_left(1, 27),
            LongitudeUnsigned - binary_shift_left(1, 28),
            LongitudeUnsigned
        ),
        LatitudeSigned = iff(
            LatitudeUnsigned >= binary_shift_left(1, 26),
            LatitudeUnsigned - binary_shift_left(1, 27),
            LatitudeUnsigned
        ),
        RateOfTurnSigned = iff(
            RateOfTurnUnsigned >= 128,
            RateOfTurnUnsigned - 256,
            RateOfTurnUnsigned
        )
    | extend
        Longitude = iff(
            LongitudeUnsigned == 108600000,
            real(null),
            todouble(LongitudeSigned) / 600000.0
        ),
        Latitude = iff(
            LatitudeUnsigned == 54600000,
            real(null),
            todouble(LatitudeSigned) / 600000.0
        ),
        SpeedOverGroundKnots = iff(
            SpeedOverGroundRaw == 1023,
            real(null),
            todouble(SpeedOverGroundRaw) / 10.0
        ),
        CourseOverGroundDegrees = iff(
            CourseOverGroundRaw == 3600,
            real(null),
            todouble(CourseOverGroundRaw) / 10.0
        ),
        TrueHeadingDegrees = iff(
            TrueHeadingRaw == 511,
            long(null),
            TrueHeadingRaw
        ),
        UTCSecond = iff(
            UTCSecondRaw >= 60,
            long(null),
            UTCSecondRaw
        ),
        PositionAccuracy = PositionAccuracyRaw == 1,
        RAIM = RAIMRaw == 1,
        RateOfTurnRaw = RateOfTurnSigned
    | extend IsValidPosition =
        isnotnull(Latitude)
        and isnotnull(Longitude)
        and Latitude between (-90.0 .. 90.0)
        and Longitude between (-180.0 .. 180.0)
    | project
        ReceivedTime,
        MessageType = DecodedMessageType,
        RepeatIndicator,
        MMSI,
        NavigationStatus,
        RateOfTurnRaw,
        SpeedOverGroundKnots,
        PositionAccuracy,
        Longitude,
        Latitude,
        CourseOverGroundDegrees,
        TrueHeadingDegrees,
        UTCSecond,
        ManeuverIndicator,
        RAIM,
        IsValidPosition,
        SentenceType,
        TotalFragments,
        FragmentNumber,
        SequenceId,
        Channel,
        Payload,
        FillBits,
        Checksum
}
.alter table AisNormalized policy update "[{\"IsEnabled\":true,\"Source\":\"AisRaw\",\"Query\":\"NormalizeAis()\",\"IsTransactional\":false,\"PropagateIngestionProperties\":false,\"ManagedIdentity\":null}]"
.alter table AisPositionReports policy update "[{\"IsEnabled\":true,\"Source\":\"AisNormalized\",\"Query\":\"RouteAisPositionReports()\",\"IsTransactional\":true,\"PropagateIngestionProperties\":false,\"ManagedIdentity\":null}]"
.alter table AisStaticReports policy update "[{\"IsEnabled\":true,\"Source\":\"AisNormalized\",\"Query\":\"RouteAisStaticReports()\",\"IsTransactional\":false,\"PropagateIngestionProperties\":false,\"ManagedIdentity\":null}]"
.alter table AisInfrastructureReports policy update "[{\"IsEnabled\":true,\"Source\":\"AisNormalized\",\"Query\":\"RouteAisInfrastructureReports()\",\"IsTransactional\":false,\"PropagateIngestionProperties\":false,\"ManagedIdentity\":null}]"
.alter table AisBinaryMessages policy update "[{\"IsEnabled\":true,\"Source\":\"AisNormalized\",\"Query\":\"RouteAisBinaryMessages()\",\"IsTransactional\":false,\"PropagateIngestionProperties\":false,\"ManagedIdentity\":null}]"
.alter table AisSafetyMessages policy update "[{\"IsEnabled\":true,\"Source\":\"AisNormalized\",\"Query\":\"RouteAisSafetyMessages()\",\"IsTransactional\":false,\"PropagateIngestionProperties\":false,\"ManagedIdentity\":null}]"
.alter table AisControlMessages policy update "[{\"IsEnabled\":true,\"Source\":\"AisNormalized\",\"Query\":\"RouteAisControlMessages()\",\"IsTransactional\":false,\"PropagateIngestionProperties\":false,\"ManagedIdentity\":null}]"
.alter table AisDecodedClassAPosition policy update "[{\"IsEnabled\":true,\"Source\":\"AisPositionReports\",\"Query\":\"DecodeAisClassAPosition()\",\"IsTransactional\":false,\"PropagateIngestionProperties\":false,\"ManagedIdentity\":null}]"
.alter table AisDeadLetter policy update "[{\"IsEnabled\":true,\"Source\":\"AisRaw\",\"Query\":\"RouteAisDeadLetter()\",\"IsTransactional\":false,\"PropagateIngestionProperties\":false,\"ManagedIdentity\":null}]"

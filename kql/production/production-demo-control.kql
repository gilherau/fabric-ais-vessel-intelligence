// ============================================================
// Microsoft Fabric AIS production demo control script
//
// Purpose:
//   Provides operator-friendly demo blocks for validating the
//   production Eventhouse tables, update policies, parser routing,
//   dead-letter handling, and map rendering.
//
// Usage:
//   Run this file one block at a time in a Fabric KQL database after
//   deploying create-eventhouse-schema-and-policies.kql.
//
// Recommended flow:
//   1. Run BLOCK 1 to reset the demo tables.
//   2. Run BLOCK 2 to ingest the Staten Island Ferry sample track.
//   3. Run BLOCK 3 to ingest AIS parser coverage records.
//   4. Run BLOCK 4A and BLOCK 4B to validate routing and dead-letter behavior.
//   5. Run BLOCK 5 to render only the ferry track on a map.
//
// Note:
//   BLOCK 3 includes additional valid position messages spread across
//   different locations. BLOCK 5 filters by MMSI and timestamp so the
//   map remains focused on the Staten Island Ferry sample even after
//   parser coverage data has been ingested.
//
// Safety:
//   Historical public AIS sample data is for analytics demonstration
//   only. Do not use this output for navigation, vessel operations,
//   emergency response, or safety-of-life decisions.
// ============================================================

// ============================================================
// BLOCK 1: Reset demo tables
// ============================================================
.execute database script <|
// Clear bronze table
.clear table AisRaw data;
// Clear silver tables
.clear table AisNormalized data ;
.clear table AisDeadLetter data;
// Clear gold tables
.clear table AisPositionReports data;
.clear table AisStaticReports data;
.clear table AisInfrastructureReports data;
.clear table AisBinaryMessages data;
.clear table AisSafetyMessages data;
.clear table AisControlMessages data;
.clear table AisDecodedClassAPosition data;

// ============================================================
// BLOCK 2: Ingest Staten Island Ferry sample track
// ============================================================
//
// Data source:
//   Derived from NOAA's public AIS archive for 2024:
//   https://coast.noaa.gov/htdata/CMSP/AISDataHandler/2024/
//
// Purpose:
//   Demonstrates end-to-end production update-policy flow from
//   AisRaw to AisDecodedClassAPosition.
//
.set-or-append AisRaw <|
datatable (ReceivedTime:datetime, RawSentence:string)
[
    datetime(2024-07-25T01:05:15.000Z), "!AIVDM,1,1,,A,15MwrC0P1lre;OtGBHMaTW`N0000,0*4F",
    datetime(2024-07-25T01:06:19.000Z), "!AIVDM,1,1,,B,15MwrC0P24re:9DGBDG9JWHV0000,0*20",
    datetime(2024-07-25T01:07:22.000Z), "!AIVDM,1,1,,A,15MwrC0P29re8uHGB>Ha6W@d0000,0*07",
    datetime(2024-07-25T01:08:32.000Z), "!AIVDM,1,1,,B,15MwrC0P2:re7mhGB8<`r7100000,0*42",
    datetime(2024-07-25T01:09:33.000Z), "!AIVDM,1,1,,A,15MwrC0P28re6iDGB1n8eVg20000,0*4B",
    datetime(2024-07-25T01:10:35.000Z), "!AIVDM,1,1,,B,15MwrC0P25re5rhGArd`?VM60000,0*17",
    datetime(2024-07-25T01:11:42.000Z), "!AIVDM,1,1,,A,15MwrC0P27re57<GAj68?VUD0000,0*7F",
    datetime(2024-07-25T01:12:53.000Z), "!AIVDM,1,1,,B,15MwrC0P2:re4:LGAaK8DVSb0000,0*20",
    datetime(2024-07-25T01:13:55.000Z), "!AIVDM,1,1,,A,15MwrC0P2:re3EtGAQJ836=f0000,0*2F",
    datetime(2024-07-25T01:15:02.000Z), "!AIVDM,1,1,,B,15MwrC0P24re2mpGAHD7iV>40000,0*7C",
    datetime(2024-07-25T01:16:12.000Z), "!AIVDM,1,1,,A,15MwrC0P28re23LGA?G8:VLH0000,0*37",
    datetime(2024-07-25T01:17:23.000Z), "!AIVDM,1,1,,B,15MwrC0P29re1;tGA6M8:VLf0000,0*2B",
    datetime(2024-07-25T01:18:31.000Z), "!AIVDM,1,1,,A,15MwrC0P27re0M4G@uD836Lv0000,0*23",
    datetime(2024-07-25T01:19:42.000Z), "!AIVDM,1,1,,B,15MwrC0P2:rdwT4G@lB`DVaD0000,0*3D",
    datetime(2024-07-25T01:20:52.000Z), "!AIVDM,1,1,,A,15MwrC0P2:rdvLlG@dC8jW7`0000,0*73",
    datetime(2024-07-25T01:22:02.000Z), "!AIVDM,1,1,,B,15MwrC0P2<rdtt4G@WIaTWP40000,0*79",
    datetime(2024-07-25T01:23:04.000Z), "!AIVDM,1,1,,A,15MwrC0P1RrdsllG@SAa6Vv80000,0*15",
    datetime(2024-07-25T01:24:08.000Z), "!AIVDM,1,1,,B,15MwrC0P0srds@lG@OQ`NVR@0000,0*33",
    datetime(2024-07-25T01:25:13.000Z), "!AIVDM,1,1,,A,15MwrC0P0Crds1lG@MO8NVhJ0000,0*05",
    datetime(2024-07-25T01:26:16.000Z), "!AIVDM,1,1,,B,15MwrC0P00rds38G@MVa46jP0000,0*61",
    datetime(2024-07-25T02:34:19.000Z), "!AIVDM,1,1,,A,15MwrC0P0SrdsAhG@O<QhQJV0000,0*66",
    datetime(2024-07-25T02:35:20.000Z), "!AIVDM,1,1,,B,15MwrC0P1srdso@G@RBR4WT`0000,0*50",
    datetime(2024-07-25T02:36:21.000Z), "!AIVDM,1,1,,A,15MwrC0P2HrduVLG@V`2iRHb0000,0*58",
    datetime(2024-07-25T02:37:22.000Z), "!AIVDM,1,1,,B,15MwrC0P2MrdvoLG@brR4W<d0000,0*08",
    datetime(2024-07-25T02:38:26.000Z), "!AIVDM,1,1,,A,15MwrC0P2Ure0>@G@lhQLQ<l0000,0*68",
